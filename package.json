{
  "name": "tv-smart-adaptative",
  "private": true,
  "version": "0.1.0",
  "description": "Monte a sua TV no computador e envie para ela — sem root e sempre reversível.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "shared",
    "studio/core",
    "studio/server",
    "studio/web"
  ],
  "scripts": {
    "start": "npm run build:web && node studio/server/src/main.ts",
    "dev:fake": "npm run build:web && node studio/server/src/main.ts --fake",
    "build:web": "npm run build -w studio/web",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w studio/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:hooks": "node --test .claude/hooks/adb-guard.test.mjs",
    "test:e2e": "npm run build:web && playwright test",
    "test:all": "npm run typecheck && npm run test && npm run test:hooks && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.2"
  }
}
